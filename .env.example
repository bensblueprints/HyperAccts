# Optional: configure this in your server environment, never in a solution package.
# This server reads environment variables; it does not automatically load .env files.
PORT=4173
HYPERACCTS_2CAPTCHA_KEY=
HYPERACCTS_SMSPVA_KEY=
HYPERACCTS_DAISYSMS_KEY=

# Stripe checkout (task 490). Never commit real secret keys.
# STRIPE_SECRET_KEY=sk_test_...  (test) / sk_live_... (live)
# STRIPE_WEBHOOK_SECRET=whsec_... (from `stripe listen` or Dashboard webhook configuration)
# STRIPE_PRICE_ID=price_... (a one-time $1,499 USD price created in the Stripe Dashboard)
# STRIPE_SUCCESS_URL=https://hyperaccts.com/purchase/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=https://hyperaccts.com/purchase/cancel
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
BASE_URL=https://hyperaccts.com

# Licensed delivery (task 491). LICENSE_SECRET signs license keys and download tokens.
# It must be >= 16 chars and MUST be identical across the website and any desktop-app
# verifier. Never commit a real value.
# LICENSE_SECRET=generate-something-32+chars
# DELIVERY_TOKEN_TTL=3600            # seconds a download token stays valid
# INSTALLER_PATH=website/downloads/HyperAccts-Setup-0.1.0.exe
LICENSE_SECRET=
DELIVERY_TOKEN_TTL=
INSTALLER_PATH=
HYPERACCTS_OLLAMA_URL=http://127.0.0.1:11434
HYPERACCTS_AI_MODEL=huihui_ai/qwen3-coder-next-abliterated:latest

# Persistent workflow service. Default: ~/.hyperaccts; desktop uses Electron userData.
HYPERACCTS_DATA_DIR=
# Hosted mode requires an HTTPS reverse proxy preserving Host and a separate data directory.
HYPERACCTS_PUBLIC_ORIGIN=
HYPERACCTS_ADMIN_EMAIL=
HYPERACCTS_ADMIN_PASSWORD=
# Separate marketplace Stripe Connect configuration (not the desktop license checkout).
HYPERACCTS_MARKETPLACE_STRIPE_KEY=
HYPERACCTS_MARKETPLACE_WEBHOOK_SECRET=
