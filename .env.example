# Optional: configure this in your server environment, never in a solution package.
# This server reads environment variables; it does not automatically load .env files.
PORT=4173
HYPERACCTS_2CAPTCHA_KEY=
HYPERACCTS_SMSPVA_KEY=
HYPERACCTS_DAISYSMS_KEY=

# Stripe checkout (task 490). Never commit real secret keys.
# STRIPE_SECRET_KEY=sk_test_...  (test) / sk_live_... (live)
# STRIPE_WEBHOOK_SECRET=whsec_... (from `stripe listen` or Dashboard webhook configuration)
# STRIPE_PRICE_ID=price_... (a one-time $1,499 USD price created in the Stripe Dashboard)
# STRIPE_SUCCESS_URL=https://hyperaccts.com/purchase/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=https://hyperaccts.com/purchase/cancel
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
BASE_URL=https://hyperaccts.com
