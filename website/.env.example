# HyperAccts Server Configuration
# Never commit .env (used for secrets)

# === Website ===
BASE_URL=http://127.0.0.1:4180

# === Stripe (payment gateway) ===
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# === Delivery (task 491: post-purchase flow) ===
# Must be >= 16 characters for HMAC security
LICENSE_SECRET=your-32-char-secret-minimum

# How many seconds a download token remains valid
DELIVERY_TOKEN_TTL=3600

# Path to the built Windows installer (gitignored)
# INSTALLER_PATH=/path/to/HyperAccts-Setup-0.2.0.exe
